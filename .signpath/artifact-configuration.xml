<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration untuk SignPath (salin isinya ke project StreamMirror di SignPath.io).
  Artefak = isi folder dist/StreamMirror-win32-x64 yang diunggah GitHub Actions sebagai ZIP.
  Hanya StreamMirror.exe yang ditandatangani. Biner upstream (adb.exe, uxplay.exe,
  iphone-usb.exe, DLL) ikut di paket tanpa ditandatangani, sesuai aturan SignPath Foundation
  "sign your own binaries only".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="StreamMirror.exe" product-name="StreamMirror" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
